<%# 検索結果などに表示されるタイトルと説明 %>
<% content_for :title, "#{@page_title} #{@event.display_name} #{@stage.display_name} | みんなのタイムテーブル" %>
<% content_for :description, "#{@event.display_name}の#{@page_title}「#{@stage.display_name}」。" %>
<% if modal_turbo_frame? %>
  <%= render "modal_edit" %>
<% else %>
  <div class="my-4 pb-[calc(5.25rem+env(safe-area-inset-bottom))]">
    <%= render "form", stage: @stage, editing: true %>
  </div>
  <%# 下部タブメニュー %>
  <%= render "layouts/bottom_tab" %>
<% end %>
