<p>ご意見箱に新しい投稿がありました。</p>

<p><strong>投稿日時:</strong> <%= l(@feedback.created_at, format: :long) %></p>
<% if @feedback.user.present? %>
  <p><strong>ユーザー:</strong> <%= @feedback.user.name %>（<%= @feedback.user.email %>）</p>
<% else %>
  <p><strong>ユーザー:</strong> 未ログイン</p>
<% end %>

<p><strong>内容:</strong></p>
<pre style="white-space: pre-wrap; font-family: sans-serif;"><%= @feedback.body %></pre>

<p>
  管理画面:
  <%= link_to "ご意見一覧を見る", admin_feedbacks_url %>
</p>
