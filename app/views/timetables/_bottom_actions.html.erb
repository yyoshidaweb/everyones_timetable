<%# タイムテーブル右下に固定表示するアクションボタン（オーナー向け） %>
<div class="fixed right-2 z-160
            bottom-[calc(0.5rem+5.25rem+env(safe-area-inset-bottom))]
            flex items-center gap-2">
  <%= link_to new_event_timetable_path(@event.event_key),
        aria: { label: "画像から作成" },
        class: "flex items-center justify-center p-2 bg-gray-800 text-white rounded-full shadow hover:bg-gray-900" do %>
    <span class="material-symbols-outlined">wand_stars</span>
  <% end %>
  <%= link_to new_event_performance_path(@event.event_key),
        aria: { label: "出演情報を追加" },
        class: "flex items-center justify-center p-2 bg-gray-800 text-white rounded-full shadow hover:bg-gray-900" do %>
    <span class="material-symbols-outlined">calendar_add_on</span>
  <% end %>
</div>
