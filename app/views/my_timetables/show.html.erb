<%# 検索結果などに表示されるタイトルと説明 %>
<% content_for :title, "#{@user.name}の#{@event.display_name} マイタイムテーブル | みんなのタイムテーブル" %>
<% content_for :description, "#{@user.name}の#{@event.display_name}のマイタイムテーブル。" %>
<%# 日付選択タブ（イベントヘッダーの高さ分下げて配置する） %>
<% if @days.any?%>
  <nav class="flex h-8 fixed top-16 z-160 w-full justify-around overflow-x-auto bg-white border-t border-gray-200">
    <% @days.each do |day| %>
      <%# 日付を MM/DD 形式でラベルに整形 %>
      <% label = day.date.strftime("%-m/%-d") %>
      <%# 現在選択中の日付かどうか判定 %>
      <% selected = (day.date == @selected_date) %>
      <%# 日付タブリンク。選択中の場合は下線を表示し、横幅は均等に伸ばす %>
      <%= link_to show_my_timetable_path(event_key: @event.event_key, username: @user.username, d: day.date),
            class: "flex-1 px-2 py-2 text-xs text-gray-800 font-bold border-b-4 #{selected ? 'border-gray-800' : 'border-transparent'} hover:border-gray-300 transition-colors duration-150 text-center whitespace-nowrap" do %>
        <%= label %>
      <% end %>
    <% end %>
  </nav>
<% end %>
<div id="my_timetable">
  <%= render "content" %>
</div>
<%# 下部タブメニュー %>
<% if my_timetable_owner? %>
  <%= render "layouts/bottom_tab" %>
<% else %>
  <div class="flex flex-col items-center fixed bottom-0 left-0 w-full h-21 p-1
        bg-white border-t z-200
          pb-[env(safe-area-inset-bottom)]">
    <small class="mb-1 text-center text-xs text-gray-500 whitespace-normal md:whitespace-nowrap">
      ※みんなのタイムテーブルで作成された非公式タイムテーブルです。
      必ず公式情報をご確認の上、ご利用ください。
    </small>
    <div class="mt-1 w-full flex justify-center">
      <%= link_to show_timetable_path(@event.event_key),
                                          class: "text-sm text-blue-600 hover:underline" do %>
        <span class="font-semibold">タイムテーブルを見る→</span>
      <% end %>
    </div>
  </div>
<% end %>
