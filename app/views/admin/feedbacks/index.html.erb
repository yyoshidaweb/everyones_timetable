<% content_for :title, "#{@page_title} | みんなのタイムテーブル" %>
<% content_for :description, "開発者向けご意見箱一覧。" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="mb-4">
  <%= link_to "← 管理画面に戻る", admin_dashboard_path, class: "text-sm text-blue-600 hover:underline" %>
</div>

<section>
  <p class="mb-4 text-sm text-gray-600">総数: <%= @feedbacks_count %></p>
  <% if @feedbacks.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm text-left text-gray-800 border border-gray-200">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-3 py-2 font-semibold">ID</th>
            <th class="px-3 py-2 font-semibold">内容</th>
            <th class="px-3 py-2 font-semibold">ユーザー</th>
            <th class="px-3 py-2 font-semibold">投稿日時</th>
          </tr>
        </thead>
        <tbody>
          <% @feedbacks.each do |feedback| %>
            <tr class="border-b border-gray-100 align-top">
              <td class="px-3 py-2"><%= feedback.id %></td>
              <td class="px-3 py-2 whitespace-pre-wrap"><%= feedback.body %></td>
              <td class="px-3 py-2">
                <% if feedback.user.present? %>
                  <%= feedback.user.name %><br>
                  <span class="text-gray-500"><%= feedback.user.email %></span>
                <% else %>
                  <span class="text-gray-500">未ログイン</span>
                <% end %>
              </td>
              <td class="px-3 py-2"><%= l(feedback.created_at, format: :long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-600">まだご意見はありません。</p>
  <% end %>
</section>
