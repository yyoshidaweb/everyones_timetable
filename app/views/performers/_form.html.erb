<% editing = local_assigns.fetch(:editing, false) %>
<% form_data = modal_turbo_frame? ? { turbo_frame: "_top" } : { turbo: turbo_frame_request? } %>
<div class="max-w-md mx-auto p-6 bg-white shadow-md rounded-lg"
     data-controller="tag-suggestion"
     data-tag-suggestion-url-value="<%= search_performer_name_tags_path %>">
  <%= form_with model: performer,
                data: form_data,
                url: editing ? event_performer_path(@event.event_key, performer) : event_performers_path(@event.event_key),
                method: editing ? :patch : :post,
                class: "space-y-6" do |f| %>
    <%# エラーメッセージ %>
    <%= render "devise/shared/error_messages", resource: performer %>
    <% if modal_turbo_frame? %>
      <%= hidden_field_tag :from_modal, "1" %>
    <% end %>
    <%# ─ 出演者名（タグ入力＋候補表示） ─ %>
    <div>
      <%= f.label :performer_name_tag, "出演者名", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%# fields_for を使って nested attributes の形で name を送る (performer[performer_name_tag_attributes][name]) %>
      <%= f.fields_for :performer_name_tag do |ff| %>
        <%= ff.text_field :name,
          value: performer.performer_name_tag&.name,
          class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800 
                  focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800",
          data: {
            tag_suggestion_target: "input",
            action: "input->tag-suggestion#search"
          } %>
        <%# タグ候補（ポップアップ表示領域） %>
        <div class="relative" data-tag-suggestion-target="results"></div>
      <% end %>
    </div>
    <%# 説明欄 %>
    <div>
      <%= f.label :description, "説明", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%= f.text_area :description,
        class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800
                focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800 min-h-32 resize-y overflow-y-auto"%>
    </div>
    <%# 公式サイト %>
    <div>
      <%= f.label :website_url, "公式サイト", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%= f.text_field :website_url,
        class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800" %>
    </div>
    <%# 送信ボタン %>
    <div>
      <%= f.submit editing ? "更新" : "作成",
        class: "w-full py-2 rounded-md bg-gray-800 text-white hover:bg-gray-900 transition cursor-pointer" %>
    </div>
  <% end %>
  <% if editing %>
    <% if modal_turbo_frame? %>
      <div class="mt-4 flex justify-end">
        <%= link_to "キャンセル",
                    event_performer_path(@event.event_key, performer),
                    data: { action: "click->modal#navigate" },
                    class: "text-sm text-gray-600 hover:underline" %>
      </div>
    <% end %>
    <%= button_to "削除",
                event_performer_path(@event.event_key, performer),
                method: :delete,
                params: modal_turbo_frame? ? { from_modal: "1" } : {},
                data: {
                  turbo_confirm: "⚠️ この出演者に紐づく出演情報もすべて削除されます。 本当に削除しますか？",
                  turbo_frame: modal_turbo_frame? ? "_top" : nil
                }.compact,
                class: "flex justify-center w-full mt-24 py-2 rounded-md bg-gray-800 text-red-500 hover:bg-red-700 hover:text-red-200 transition cursor-pointer" %>
  <% end %>
</div>
