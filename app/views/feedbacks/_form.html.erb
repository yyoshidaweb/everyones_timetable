<section class="mb-12 w-full flex flex-col space-y-4">
  <h2 class="flex items-center font-semibold text-xl text-center text-gray-800 mb-2">
    <span class="material-symbols-outlined mr-1">chat</span>
    ご意見箱
  </h2>
  <p class="text-sm text-gray-500 leading-relaxed">
    返信はできません。サービス改善の参考にさせていただきます。
  </p>
  <%= form_with model: Feedback.new, url: feedbacks_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :body, "ご意見・ご要望", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%= f.text_area :body,
            required: true,
            maxlength: 2000,
            rows: 5,
            placeholder: "使いにくい点や、あったらうれしい機能など",
            class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800 min-h-32 resize-y overflow-y-auto" %>
    </div>
    <div>
      <%= f.submit "送信する",
            class: "w-full py-2 rounded-full bg-gray-800 text-white hover:bg-gray-900 transition cursor-pointer" %>
    </div>
  <% end %>
</section>
